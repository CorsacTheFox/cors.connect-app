<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/accent_emerald_soft" />
        </shape>
    </item>
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="70%"
                android:startColor="@color/hero_core_top"
                android:endColor="@color/hero_core_bottom" />
            <stroke android:width="1dp" android:color="@color/accent_emerald" />
        </shape>
    </item>
</layer-list>
