<?xml version="1.0" encoding="utf-8"?>
<!-- Connection / server row — Nocturne redesign prototype 1a.
     Bound by MainFragmentView.bindServerRow / bindWhitelistBypassRow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_destination_card"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="7dp">

    <View
        android:id="@+id/rowStatusDot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginEnd="11dp"
        android:background="@drawable/bg_status_dot_idle" />

    <!-- Country flag emoji pulled off the front of the server name. -->
    <TextView
        android:id="@+id/rowFlag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:includeFontPadding="false"
        android:textSize="26sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textFontWeight="600"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/rowLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/ink_3"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/rowProtocol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/row_ink_34"
            android:textSize="9sp" />

        <!-- Node load bar (Xray rows, from the panel's node-load feed) -->
        <LinearLayout
            android:id="@+id/rowLoadRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="monospace"
                android:text="@string/node_load_label"
                android:textColor="@color/ink_3"
                android:textSize="9sp" />

            <ProgressBar
                android:id="@+id/rowLoadBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="2dp"
                android:max="100"
                android:progressBackgroundTint="@color/hair_strong" />

            <TextView
                android:id="@+id/rowLoadPercent"
                android:layout_width="34dp"
                android:gravity="end"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/ink_3"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/rowPing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.06"
        android:textColor="@color/ink_3"
        android:textSize="10sp" />
</LinearLayout>
