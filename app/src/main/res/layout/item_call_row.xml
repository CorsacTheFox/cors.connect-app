<?xml version="1.0" encoding="utf-8"?>
<!-- Connection / server row — Nocturne redesign prototype 1a.
     Bound by MainFragmentView.bindServerRow / bindWhitelistBypassRow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:background="@drawable/bg_destination_card"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="13dp"
    android:paddingVertical="9dp">

    <View
        android:id="@+id/rowStatusDot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginEnd="11dp"
        android:background="@drawable/bg_status_dot_idle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textFontWeight="600"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/rowLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/ink_3"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/rowProtocol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/row_ink_34"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowPing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.06"
        android:textColor="@color/ink_3"
        android:textSize="10sp" />
</LinearLayout>
