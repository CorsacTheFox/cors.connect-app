<?xml version="1.0" encoding="utf-8"?>
<!-- First-run onboarding — Nocturne redesign prototype 1a (isOnboard). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_ob_logo_chip">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_cors_mark"
                app:tint="@color/accent_emerald" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textFontWeight="600"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:letterSpacing="-0.02"
        android:text="@string/ob_title"
        android:textColor="@color/ink"
        android:textFontWeight="600"
        android:textSize="27sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.4"
        android:text="@string/ob_sub"
        android:textColor="@color/ink_3"
        android:textSize="13.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <include layout="@layout/item_ob_step" android:id="@+id/obStep1" />

        <include layout="@layout/item_ob_step" android:id="@+id/obStep2" />

        <include layout="@layout/item_ob_step" android:id="@+id/obStep3" />

        <include layout="@layout/item_ob_step" android:id="@+id/obStep4" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_log_box_warn"
        android:lineSpacingMultiplier="1.35"
        android:padding="12dp"
        android:text="@string/ob_free_note"
        android:textColor="@color/warn_amber"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="18dp" />

    <LinearLayout
        android:id="@+id/obAuthButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_cors_signin_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="9dp"
            android:src="@drawable/ic_telegram"
            app:tint="@color/accent_emerald" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ob_auth"
            android:textColor="@color/accent_emerald"
            android:textFontWeight="600"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/obSkipButton"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/ob_skip"
        android:textColor="@color/ink_3"
        android:textSize="12.5sp" />
</LinearLayout>
