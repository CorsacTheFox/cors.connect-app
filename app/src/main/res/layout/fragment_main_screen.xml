<?xml version="1.0" encoding="utf-8"?>
<!-- Cors.Connect main / "connect" screen. Layout follows the Nocturne
     redesign prototype (Cors.Connect Redesign.dc.html, screen 1a). View ids
     are the binding contract with MainFragmentView.kt — keep them stable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Fixed top: header, route status, connected stats/graph, actions.
         Only the connection list below scrolls. -->
    <LinearLayout
        android:id="@+id/mainTop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp">


        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/headerSub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/jetbrains_mono"
                android:letterSpacing="0.14"
                android:textAllCaps="true"
                android:text="@string/main_sub_no_configs"
                android:textColor="@color/ink_3"
                android:textSize="10sp" />

            <ImageButton
                android:id="@+id/headerScanButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/scan_qr_title"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_qr"
                app:tint="@color/ink_2" />

            <ImageButton
                android:id="@+id/headerAddButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/picker_add_title"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_plus"
                app:tint="@color/ink_2" />
        </LinearLayout>

        <!-- Route header: typographic status (redesign prototype, screen 1b) -->
        <TextView
            android:id="@+id/routeStatusLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/jetbrains_mono"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            android:text="@string/status_headline_disconnected"
            android:textColor="@color/accent_emerald"
            android:textSize="10sp" />

        <!-- Single line so a long connection name never reflows the whole
             screen — extra text ellipsizes instead. -->
        <TextView
            android:id="@+id/routeCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.0"
            android:maxLines="1"
            android:text="@string/connection_type_whitelist_bypass"
            android:textColor="@color/ink"
            android:textFontWeight="500"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/authHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/jetbrains_mono"
            android:text="@string/auth_required_hint"
            android:textColor="@color/warn_amber"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/authHintBotLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:drawablePadding="6dp"
            android:focusable="true"
            android:fontFamily="@font/jetbrains_mono"
            android:paddingVertical="2dp"
            android:text="@string/auth_hint_bot_link"
            android:textColor="@color/accent_emerald"
            android:textSize="10.5sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_telegram"
            app:drawableTint="@color/accent_emerald" />

        <TextView
            android:id="@+id/statusDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/jetbrains_mono"
            android:text="@string/status_detail_pick_call"
            android:textColor="@color/ink_3"
            android:textSize="11sp" />

        <!-- Connected: the traffic graph takes all spare height so the screen
             fills the viewport; gone (and weightless) when disconnected. -->
        <bypass.whitelist.ui.SparklineView
            android:id="@+id/routeSpark"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Connected: one card in the active-server style — the server row on
             top, session stats and the device → exit route below. -->
        <LinearLayout
            android:id="@+id/connectedCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_destination_card_active"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/connectedServerSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="10dp"
                android:background="@color/hair" />

            <!-- device -> exit exchange -->
            <LinearLayout
                android:id="@+id/routeExchangeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone">

                <!-- Same 3-column grid as the stats below: device | → | exit -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/StatLabel"
                        android:text="@string/main_route_device" />

                    <TextView
                        android:id="@+id/routeDeviceValue"
                        style="@style/ConnStatValue"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="LTE" />
                </LinearLayout>

                <!-- Middle column: arrow device → exit -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/accent_emerald" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/StatLabel"
                        android:text="@string/main_route_exit" />

                    <TextView
                        android:id="@+id/routeExitValue"
                        style="@style/ConnStatValue"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="185.42.7.19" />
                </LinearLayout>
            </LinearLayout>

            <!-- Session metrics, compact — all above the connect button (screen 1b) -->
            <LinearLayout
                android:id="@+id/routeStatsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/StatLabel" android:text="@string/stat_uptime" />

                        <TextView
                            android:id="@+id/routeUptime"
                            style="@style/ConnStatValue"
                            tools:text="00:14:08" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/StatLabel" android:text="@string/stat_ping" />

                        <TextView
                            android:id="@+id/routePing"
                            style="@style/ConnStatValue"
                            tools:text="38 мс" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/routeLeftCell"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/StatLabel" android:text="@string/stat_days_left" />

                        <TextView
                            android:id="@+id/routeLeft"
                            style="@style/ConnStatValue"
                            tools:text="14" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/StatLabel" android:text="@string/stat_rx" />

                        <TextView
                            android:id="@+id/routeRx"
                            style="@style/ConnStatValue"
                            tools:text="4.2 МБ/с" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/StatLabel" android:text="@string/stat_tx" />

                        <TextView
                            android:id="@+id/routeTx"
                            style="@style/ConnStatValue"
                            tools:text="0.8 МБ/с" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/routeUsedCell"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/StatLabel" android:text="@string/stat_traffic" />

                        <TextView
                            android:id="@+id/routeUsed"
                            style="@style/ConnStatValue"
                            tools:text="12.4 GB" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Service reachability check, inside the connected card -->
            <LinearLayout
                android:id="@+id/pingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/pingButton"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_ping_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/pingButtonDot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_status_dot_idle" />

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_radar"
                        app:tint="@color/ink" />

                    <TextView
                        android:id="@+id/pingButtonLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/services_run"
                        android:textColor="@color/ink"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Route section header (connected / connecting only) -->
        <LinearLayout
            android:id="@+id/routeSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/jetbrains_mono"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:text="@string/main_route_section"
                android:textColor="@color/ink_3"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/routeAllServers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingVertical="2dp"
                android:text="@string/main_route_all_servers"
                android:textColor="@color/accent_emerald"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pull down to refresh subscriptions + pings. Keeps the
         mainListScroll id: MainFragmentView re-weights it per state. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/mainListScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/mainListScrollInner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        android:scrollbarSize="3dp"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarThumbVertical="@drawable/bg_scroll_thumb"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp">
            <!-- Connection list -->
            <LinearLayout
                android:id="@+id/callsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/emptyCta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_destination_card_empty"
                android:baselineAligned="false"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_empty_cta_plus">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/accent_emerald" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/emptyCtaTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_calls_title"
                        android:textColor="@color/accent_emerald"
                        android:textFontWeight="600"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/emptyCtaSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/jetbrains_mono"
                        android:text="@string/empty_calls_sub"
                        android:textColor="@color/ink_3"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>


            <!-- Refresh subscriptions at the end of the list (ping runs automatically) -->
            <LinearLayout
                android:id="@+id/serverActionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/pingAllButton"
                    android:visibility="gone"
                android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ping_button"
                    android:clickable="true"
                    android:contentDescription="@string/ping_check_button"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/pingAllIcon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_radar"
                        app:tint="@color/ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ping_button"
                        android:textColor="@color/ink"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/refreshSubsButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                
                    android:layout_weight="1"
                    android:background="@drawable/bg_ping_button"
                    android:clickable="true"
                    android:contentDescription="@string/xray_refresh_button"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/refreshSubsIcon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_setting_update"
                        app:tint="@color/ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/refresh_subscriptions_button"
                        android:textColor="@color/ink"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Service reachability check -->
        </LinearLayout>
    </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Bottom dock: connect button + quick settings, pinned above the nav bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

            <!-- connect / disconnect -->
            <LinearLayout
                android:id="@+id/connectBar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_cors_connect_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/connectBarIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="9dp"
                    android:src="@drawable/ic_power"
                    app:tint="@color/accent_emerald" />

                <TextView
                    android:id="@+id/connectBarLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:text="@string/hero_connect"
                    android:textColor="@color/accent_emerald"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Quick chips -->
            <LinearLayout
                android:id="@+id/quickChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/quickChipSplit"
                    style="@style/QuickChip"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/settings_row_split" />

                <TextView
                    android:id="@+id/quickChipBot"
                    style="@style/QuickChip"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="0dp"
                    android:text="@string/main_chip_subscription" />

                <!-- Kept for MainFragmentView bindings; not shown on the main screen. -->
                <TextView
                    android:id="@+id/quickChipTunnel"
                    style="@style/QuickChip"
                    android:text="@string/settings_row_tunnel_mode"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/quickChipDns"
                    style="@style/QuickChip"
                    android:text="@string/settings_row_dns"
                    android:visibility="gone" />
            </LinearLayout>
    </LinearLayout>
</LinearLayout>
